PORT=3210
PUBLIC_PORT=3210
HOST=127.0.0.1
BASE_URL=http://localhost:3210
NODE_ENV=development

# Acesso da dashboard — use valores exclusivos por cliente
ADMIN_EMAIL=seu-email@empresa.com.br
ADMIN_NAME=Administrador Atenva
ADMIN_PASSWORD=
SESSION_SECRET=
INTEGRATION_ENCRYPTION_KEY=
SESSION_HOURS=8
TRUST_PROXY=false

# Persistência do SQLite em uma função protegida do Supabase (produção)
SUPABASE_SNAPSHOT_URL=
SUPABASE_ANON_KEY=
SNAPSHOT_SYNC_KEY=
SNAPSHOT_COMPANY=atenva-demo

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=troque-este-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Aplicativo central da Atenva — Embedded Signup para clientes
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_LOGIN_CONFIG_ID=
META_REDIRECT_URI=
META_OAUTH_SCOPES=ads_read,business_management,pages_show_list,pages_read_engagement,leads_retrieval,pages_manage_metadata
# Ative somente depois de a Meta conceder acesso avançado a leads_retrieval.
META_ENABLE_LEADS_RETRIEVAL=false
META_LEADS_VERIFY_TOKEN=

# Evolution API — a interface cria instância, webhook e QR automaticamente
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=atenva-principal
EVOLUTION_WEBHOOK_SECRET=

# IA real: em deploys Vercel o Gateway usa VERCEL_OIDC_TOKEN automaticamente.
# Para outro servidor, informe AI_GATEWAY_API_KEY de forma segura.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# Endpoint compatível com Chat Completions (alternativa ao AI Gateway)
AI_API_URL=
AI_API_KEY=
AI_MODEL=
